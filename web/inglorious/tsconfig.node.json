{
  // eslint.config.ts is left out until @inglorious/eslint-config publishes its type
  // declarations: 1.1.2 on npm lacks them (and its ./typescript entry, so `pnpm lint`
  // fails too). Put it back in "include" after upgrading.
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["vite.config.ts"]
}
